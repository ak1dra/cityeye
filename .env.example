# ============================================================
# CityEye Environment Configuration
# ============================================================
# Each Alem service has its OWN API key.

# --- Qwen 3 (LLM: classification + routing) ---
ALEM_API_KEY=your_qwen3_key
ALEM_MODEL=qwen3

# --- Deepseek OCR (vision: extract text from photos) ---
ALEM_OCR_API_KEY=your_ocr_key
ALEM_OCR_MODEL=deepseek-ocr

# --- Embedder (text → vector for duplicate search) ---
ALEM_EMBEDDER_API_KEY=your_embedder_key
ALEM_EMBEDDER_MODEL=text-1024

# --- Reranker (semantic ranking of similar reports) ---
ALEM_RERANKER_API_KEY=your_reranker_key
ALEM_RERANKER_MODEL=reranker

# --- Speech-to-text Kazakh (voice input) ---
ALEM_STT_API_KEY=your_stt_key
ALEM_STT_MODEL=speech-to-text-kk

# --- RAGFlow (Knowledge Base for routing) ---
RAGFLOW_API_URL=your_ragflow_url
RAGFLOW_API_KEY=your_ragflow_api_key
RAGFLOW_DATASET_ID=your_dataset_id

# --- Langfuse (AI pipeline tracing & observability) ---
LANGFUSE_SECRET_KEY=your_langfuse_secret
LANGFUSE_PUBLIC_KEY=your_langfuse_public
LANGFUSE_BASE_URL=https://a1-langfuse1.alem.ai

# --- Supabase ---
SUPABASE_URL=https://dvwfjpqbnusjegwtpyau.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_URL=https://dvwfjpqbnusjegwtpyau.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# --- Anthropic (legacy fallback) ---
ANTHROPIC_API_KEY=your_anthropic_key
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- General ---
ALEM_TIMEOUT_MS=20000
ANALYZE_TIMEOUT_MS=15000
ASSISTANT_TIMEOUT_MS=15000
NODE_ENV=production
